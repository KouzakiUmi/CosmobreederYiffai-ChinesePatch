   "side": "sfw",
   "archive": "cosmobreeder-multi.jar",
   "entry": "vsn/143",
   "line": 18,
   "kind": "line",
   "count": 1,
   "actor_slot": false,
   "text": "lang(Fox): 议会失去了一位代表重要力量的 Fenfen 核心成员，"
  },
