   "side": "nsfw",
   "archive": "patch.pak",
   "entry": "datadf/1",
   "line": 2562,
   "kind": "line",
   "count": 1,
   "actor_slot": false,
   "text": "  Mauser: [嗯，如果你哪天亲眼碰到这些Fenfen，也许你该留意他们对你说的话？]"
  },
