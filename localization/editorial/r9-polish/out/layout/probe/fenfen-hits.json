   "side": "sfw",
   "archive": "cosmobreeder-multi.jar",
   "entry": "vsn/143",
   "line": 13,
   "kind": "line",
   "count": 1,
   "actor_slot": false,
   "text": "lang(Fox): 和这片土地上原本爱好和平的Fenfen。"
  },
