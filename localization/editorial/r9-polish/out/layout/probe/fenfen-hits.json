   "archive": "cosmobreeder-multi.jar",
   "entry": "vsn/143",
   "line": 37,
   "kind": "line",
   "count": 1,
   "actor_slot": false,
   "text": "lang(Fox): 躲避Fenfen议会的力量。"
  },
