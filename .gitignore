# 原版游戏文件与外部依赖（JDK/JRE/r27底座/字体包）：不入库
originals/
deps/

# 构建产物与发行安装包：由 tools/tl_tool.py 与 release_tool.py 本地生成
payload/
dist/
build/
.local/

# 译文工作区：chunks 与 template 含游戏原文，由 tl_tool.py export 本地生成
tl_work/chunks/
tl_work/template/

# 原版图集的参考切片；资源路径及范围记录仍可维护
assets/fixed/*.png

# 含原文列的本地校对中间产物
review/sheet_*.tsv
review/candidates.tsv
review/backup_chunks_*/
review/context-mapping.json
review/defeat-context.json
review/defeat-scenes.txt
review/findings.md
review/leftover-proposals.md
# 历史双语裁决表及逐句审校输入在旧提交中保留，不随新公开树迁移
review/archive/
tl_work/archive/ledgers/

