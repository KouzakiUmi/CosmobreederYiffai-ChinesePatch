*.save
*.log
*.jsonl.tmp
.lastpid
all_strings.txt
.credentials.yaml
**/.credentials.yaml
.env
.env.*
!.env.example
*.pem
*.key

# Generated Python / build output.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.spec
